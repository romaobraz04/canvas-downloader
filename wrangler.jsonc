{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "canvas-downloader",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "./web",
    "run_worker_first": ["/api/*"]
  }
}
